# Copy this file to .env and fill in your values. Never commit .env to GitHub.

# From @BotFather on Telegram
TELEGRAM_TOKEN=

# From the Claude Console (console.anthropic.com)
ANTHROPIC_API_KEY=

# Leave blank at first. Run the bot, send it /start, and it will tell you this number.
ALLOWED_CHAT_ID=

# Optional
CLAUDE_MODEL=claude-haiku-5-5
TIMEZONE=America/Chicago
